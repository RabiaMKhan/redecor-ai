# Copy to .env and fill in. Never commit .env.
PORT=8080
MONGO_URL=mongodb://127.0.0.1:27017/redecor_ai
# On Vercel, the MongoDB Atlas integration sets MONGODB_URI instead (either one works)
# MONGODB_URI=
# Database name to use when the URI has none (Atlas links usually don't)
# MONGODB_DB=redecor_ai
# Long random string, e.g. node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me
# Signs the private image links (/media/...). Falls back to JWT_SECRET when empty.
MEDIA_SECRET=
# Frontend URL(s) allowed by CORS, comma separated
CLIENT_URL=http://localhost:3002
# Set to 1 when running behind a proxy (Render, Railway, Nginx). Automatic on Vercel.
TRUST_PROXY=

# Gmail address + app password for OTP emails. Leave empty locally: codes print to the console.
EMAIL_USER=
EMAIL_PASS=

# Claude (Anthropic) writes the analysis. Empty key or AI_DEMO_MODE=true = sample analysis, no API calls.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
AI_DEMO_MODE=true
AI_DAILY_LIMIT=20

# Replicate (FLUX Kontext) creates the visual result. Empty token or VISUAL_DEMO_MODE=true = labelled demo image.
REPLICATE_API_TOKEN=
REPLICATE_MODEL=black-forest-labs/flux-kontext-pro
VISUAL_DEMO_MODE=
VISUAL_DAILY_LIMIT=10

# Guest accounts (one-click demo login): smaller daily limits, and how many per IP per hour
GUEST_AI_DAILY_LIMIT=5
GUEST_VISUAL_DAILY_LIMIT=5
GUEST_RATE_LIMIT=10
